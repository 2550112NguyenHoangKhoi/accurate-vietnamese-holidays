ACTION:DISPLAY
DESCRIPTION:Nhắc nhở: Tết Hạ Nguyên
TRIGGER:PT0S
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Nhắc nhở: Tết Hạ Nguyên
TRIGGER:-P1DT15H
END:VALARM
