BEGIN:VEVENT
UID:20730130-02299-5d7dd5c41c5b@vietnam-holidays
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20730130
DTEND;VALUE=DATE:20730131
SUMMARY:Ngày ông Táo về trời
DESCRIPTION:23 tháng Chạp\nTheo quan niệm của dân gian\, 23 ông T
 áo về trời\, tâu với Ngọc Hoàng chuyện đời trong năm. Vì
  thế\, người Việt làm lễ cúng ông Táo thịnh soạn\, với 
 mong muốn ông Táo sẽ tâu những điều tốt đẹp với Ngọc 
 Hoàng.\n- Tiễn ông Táo - Nét đẹp văn hóa dân gian:\nNgười V
 iệt cúng cá chép để ông Táo có phương tiện về chầu tr
 ời. Ở miền Bắc người ta cúng một con cá chép còn sống t
 hả trong chậu nước\, ngụ ý 'cá hóa long' nghĩa là cá sẽ b
 iến thành Rồng đưa ông Táo về trời. Con cá chép này sẽ 
 được 'phóng sinh' (thả ra ao hồ hay ra sông) sau khi cúng.\nỞ
  miền Trung\, người ta cúng một con ngựa bằng giấy với yê
 n\, cương đầy đủ.\nMiền Nam thì lễ vật đơn giản\, cúng
  mũ\, áo và đôi hia bằng giấy. Tùy theo từng gia cảnh\, ngo
 ài các lễ vật chính kể trên\, người dân làm mâm cỗ mặn
  (với xôi gà\, chân giò luộc\, các món nấu nấm\, măng…) h
 ay lễ chay (trầu cau\, hoa\, quả\, giấy vàng\, giấy bạc…) 
 để tiễn Táo Quân.
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Nhắc nhở: Ngày ông Táo về trời
TRIGGER:PT0S
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Nhắc nhở: Ngày ông Táo về trời
TRIGGER:-P1DT15H
END:VALARM
END:VEVENT
